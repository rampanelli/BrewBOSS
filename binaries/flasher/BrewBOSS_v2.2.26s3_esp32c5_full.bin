        function renderGauge(id,label,val,target,color,max=110,labelColor=''){
            var el=document.getElementById(id),isTemp=!label.includes('PWM'),valid=Number.isFinite(val)&&val>-900,hasTarget=Number.isFinite(target)&&target>-900;
            if(!el.querySelector('.gauge-svg')){el.classList.add('gauge-panel');el.innerHTML=`<div class="gauge-label"></div><div class="gauge-face"><svg class="gauge-svg" viewBox="0 0 100 100"><defs><filter id="g-mobile-${id}" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="1.56"/></filter></defs><path class="gauge-bg" d="M21.7157 78.2843 A40 40 0 1 1 78.2843 78.2843" pathLength="100"></path><path class="gauge-mobile-shadow" d="M21.7157 78.2843 A40 40 0 1 1 78.2843 78.2843" pathLength="100" filter="url(#g-mobile-${id})"></path><path class="gauge-glow" d="M21.7157 78.2843 A40 40 0 1 1 78.2843 78.2843" pathLength="100" style="stroke:rgba(0,0,0,0.12)"></path><path class="gauge-fill" d="M21.7157 78.2843 A40 40 0 1 1 78.2843 78.2843" pathLength="100"></path></svg><div class="gauge-content"><div class="gauge-val"><span class="gauge-number"></span><span class="gauge-unit"></span></div></div></div><div class="gauge-target">TARGET <span></span></div>`;}
            var value=valid?(isTemp?displayTemp(val):val.toFixed(0)):'--',u=isTemp?'Â°'+unit:'%',offset=100*(1-(valid?Math.max(0,Math.min(1,val/max)):0));
            el.querySelector('.gauge-number').textContent=value;el.querySelector('.gauge-unit').textContent=u;
            el.querySelectorAll('.gauge-fill,.gauge-glow,.gauge-mobile-shadow').forEach(e=>{e.style.strokeDashoffset=offset;e.style.strokeOpacity=valid?'1':'0.1';});
            el.querySelector('.gauge-fill').style.stroke=color;
            var tgt=el.querySelector('.gauge-target');tgt.style.display=hasTarget?'':'none';tgt.style.color=color;tgt.querySelector('span').textContent=hasTarget?displayTemp(target)+u:'';
            var caption=el.querySelector('.gauge-label');caption.textContent=label.replace('POS BOIL','POST BOIL');caption.style.color=labelColor||(label.includes('SPARGE')||label.includes('COOLING')?'#2196f3':label.includes('MAIN')||label.includes('MASH')||label.includes('POS BOIL')?'#ff9800':'#f44336');
            var fitKey=value.length+'|'+(hasTarget?displayTemp(target).length:0)+'|'+u+'|'+window.innerWidth+'|'+el.clientWidth+'|'+el.clientHeight;
