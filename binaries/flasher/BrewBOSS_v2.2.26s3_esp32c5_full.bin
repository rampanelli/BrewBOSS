        function closeScanModal(){document.getElementById('wifi-scan-modal').style.display='none';}
        function loadSystem(){const gc=document.getElementById("cfg-gmt");if(gc.options.length<1)for(let i=-12;i<=14;i++)gc.innerHTML+=`<option value="${i}">GMT ${i>=0?'+':''}${i}</option>`;api("/rest/ntpservers","GET",null,(ns)=>{const ne=document.getElementById("cfg-ntp");ne.innerHTML='<option value="">Auto</option>';if(ns&&ns.servers)ns.servers.forEach(s=>ne.innerHTML+=`<option value="${s.ip}">${s.ip} ${s.label}</option>`);api("/rest/status","GET",null,(j)=>{if(!j)return;if(j.gmtOffset!==undefined)gc.value=String(j.gmtOffset);if(j.ntpServer)ne.value=j.ntpServer;});});updateAbout();apiAuthLoad();}
