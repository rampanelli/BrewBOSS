        function csvCell(s){s=(s===null||s===undefined)?"":String(s);return /[",\n\r]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;}
        function brewHms(v){if(v<0)v=0;var h=Math.floor(v/3600),m=Math.floor((v%3600)/60),x=v%60,p=function(n){return(n<10?"0":"")+n;};return p(h)+":"+p(m)+":"+p(x);}
        function buildBrewExport(cb){return (async function(){try{
