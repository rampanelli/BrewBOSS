        }
        function connectNet(){var n=scanResults[scanSel];if(!n)return;var e=document.getElementById('wifi-net-pass');var p=e?e.value:'';api('/rest/wificonnect','POST',{ssid:n.ssid,pass:p},function(j,ok){if(!ok){t('ERROR',true);return;}t('Connecting to '+n.ssid);var s=document.getElementById('wifi-sta-ssid');var q=document.getElementById('wifi-sta-pass');if(s)s.value=n.ssid;if(q)q.value=p;closeScanModal();});}
        function delNet(){var n=scanResults[scanSel];if(!n)return;api('/rest/wifinetdel','POST',{ssid:n.ssid},function(j,ok){if(!ok){t('ERROR',true);return;}delete savedNetMap[n.ssid];t('Network removed');selNet(scanSel);});}
