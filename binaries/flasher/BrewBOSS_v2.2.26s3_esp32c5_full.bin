        var savedNetMap={};
        var scanC5=false;
        var scanSel=0;
        function scanWifi(){
            var modal=document.getElementById('wifi-scan-modal');modal.style.display='flex';
            document.getElementById('wifi-scan-list').innerHTML='<p style="text-align:center;color:var(--text-dim)">Scanning...</p>';
