        }catch(err){t(err.message,true);}})();}
        function brewSaveBlob(csv,fname){var blob=new Blob([csv],{type:"text/csv"});var a=document.createElement("a"),url=URL.createObjectURL(blob);a.href=url;a.download=fname;a.click();setTimeout(function(){URL.revokeObjectURL(url);},1000);}
        function downloadBrewLog(){t("Preparing file...");buildBrewExport(function(csv,fname){brewSaveBlob(csv,fname);t("File downloaded!");});}
        function runAudit(){var eps=[{m:"GET",u:"/rest/status",label:"Brew Status"},{m:"GET",u:"/rest/config",label:"Config"},{m:"GET",u:"/rest/sensors",label:"Sensors"},{m:"GET",u:"/rest/mash",label:"Mash"},{m:"GET",u:"/rest/boil",label:"Boil"},{m:"GET",u:"/rest/wifistatus",label:"WiFi Status"},{m:"GET",u:"/rest/listRecipes",label:"Recipes"},{m:"GET",u:"/rest/events",label:"Events"},{m:"GET",u:"/rest/templog",label:"Temp Log"}];var el=document.getElementById("audit-results");if(!el)return;el.innerHTML='<p style=font-size:12px>Running audit...</p>';var rs=[],i=0;function nx(){if(i>=eps.length){var h="";rs.forEach(function(r){var c=r.ok?"#05cd99":"#f44336",d=r.keys||"";if(r.u=="/rest/listRecipes"){var n=(r.data&&r.data.recipes)?r.data.recipes.length:0;d=n+" recipes";}if(r.u=="/rest/events"){var n=(r.data&&r.data.events)?r.data.events.length:0;d=n+" events";}h+='<div style="font-size:11px;padding:2px 0"><span style=color:'+c+'>'+(r.ok?"OK":"FAIL")+'</span> ['+r.st+'] '+esc(r.label)+' <span style=color:var(--text-dim)>'+esc(d)+'</span></div>';});h+='<p style="font-size:12px;margin-top:6px;color:#05cd99">Audit complete.</p>';el.innerHTML=h;return;}var ep=eps[i];el.innerHTML='<p style=font-size:12px>Auditing '+(i+1)+'/'+eps.length+': '+esc(ep.label)+'...</p>';api(ep.u,ep.m,null,function(j,ok){var keys=j?Object.keys(j).join(", "):"";rs.push({u:ep.u,label:ep.label,ok:!!ok,st:ok?200:"ERR",keys:keys,data:j});i++;setTimeout(nx,150);});}nx();}
        function showLoad(msg,info){var m=document.getElementById('load-modal');m.style.display='flex';document.getElementById('load-msg').textContent=msg||'Processing...';document.getElementById('load-info').textContent=info||'';}
        function hideLoad(){document.getElementById('load-modal').style.display='none';var w=document.getElementById('load-bar-wrap');if(w){w.style.display='none';document.getElementById('load-bar-fill').style.width='0%';document.getElementById('load-bar-fill').style.background='#f44336';}var n=document.getElementById('load-note');if(n){n.style.display='none';n.textContent='';}}
        function showProg(msg,idx,total,name){var m=document.getElementById('load-modal');m.style.display='flex';var pct=total>0?Math.round(idx/total*100):0;document.getElementById('load-msg').textContent=msg||'Processing...';document.getElementById('load-info').textContent=(name||'')+' - '+idx+'/'+total+' ('+pct+'%)';var w=document.getElementById('load-bar-wrap'),f=document.getElementById('load-bar-fill');w.style.display='block';f.style.width=pct+'%';f.style.background='#f44336';}
        function progDone(){var f=document.getElementById('load-bar-fill');if(f){f.style.width='100%';f.style.background='#05cd99';}}
        function progNote(txt){var n=document.getElementById('load-note');if(n){n.style.display='block';n.textContent=txt||'';}}
        function fmtSize(b){if(b<1024)return b+' B';if(b<1048576)return (b/1024).toFixed(1)+' KB';return (b/1048576).toFixed(2)+' MB';}
        function sleep(ms){return new Promise(function(r){setTimeout(r,ms);});}
        function apiP(u,m,b){return new Promise(function(res){api(u,m,b,function(j,ok){res({j:j,ok:ok});});});}
        var bulkBusy=false;
        function backupData(){if(bulkBusy)return;bulkBusy=true;return (async function(){try{
            var core=null;
            var lr=await apiP("/rest/listRecipes","GET",null);
            if(!lr.ok||!lr.j||!Array.isArray(lr.j.recipes))throw new Error('Backup aborted: recipe list could not be read');
            var recs=(lr.j&&lr.j.recipes)?lr.j.recipes:[];
            showProW␀␀␀g('Exporting backup...',0,1,'reading config');
            await sleep(300);
            var cr=await apiP("/rest/backupnow","GET",null);
            if(!cr.ok||!cr.j||!cr.j.files||typeof cr.j.files!=='object')throw new Error('Backup aborted: configuration could not be read');
            core=cr.j;
            var cfgNames=(core.files)?Object.keys(core.files):[];
            var total=cfgNames.length+recs.length;
            var step=0;
            for(var c=0;c<cfgNames.length;c++){
                step++;
                showProg('Exporting backup...',step,total,cfgNames[c]);
                await sleep(300);
            }
            var full=[];
            for(var i=0;i<recs.length;i++){
                var name=(recs[i].name||('recipe '+recs[i].id));
                step++;
                showProg('Exporting backup...',step,total,name);
                var rr=null;
                for(var retry=0;retry<3;retry++){
                    rr=await apiP("/rest/getRecipe?id="+recs[i].id,"GET",null);
                    if(rr.ok&&rr.j&&rr.j.id===recs[i].id&&Array.isArray(rr.j.mashSteps)&&Array.isArray(rr.j.boilSteps))break;
                    await sleep(500);
                }
                if(!rr.ok||!rr.j||rr.j.id!==recs[i].id||!Array.isArray(rr.j.mashSteps)||!Array.isArray(rr.j.boilSteps))throw new Error('Backup aborted: failed to read '+name);
                full.push(rr.j);
                await sleep(300);
            }
            core.recipes=full;
            showProg('Exporting backup...',total,total,'done');
            progDone();
            await sleep(300);
            var payload=JSON.stringify(core,null,2);
            var blob=new Blob([payload],{type:"application/json"});
            var a=document.createElement("a");var url=URL.createObjectURL(blob);
            a.href=url;a.download="brewboss-backup.json";a.click();
            setTimeout(function(){URL.revokeObjectURL(url);},1000);
            progNote(total+' files processed - '+fmtSize(blob.size));
            t('Complete backup: config + '+full.length+' recipes');
            await sleep(2500);
            hideLoad();
        }catch(err){hideLoad();t(err.message,true);}finally{bulkBusy=false;}})();}
        function restoreBackup(e){
            var file=e.target.files[0];e.target.value='';if(!file||bulkBusy)return;
            var reader=new FileReader();reader.onerror=()=>t('Could not read backup file',true);
            reader.onload=function(ev){var data;try{data=JSON.parse(ev.target.result);if(!data||typeof data!=='object')throw 0;}catch(err){t('Invalid JSON backup',true);return;}
                if(!data.files){pendingImports=[];if(!enqueueRecipe(data))return;showImportPreview();return;}
                if(typeof data.files!=='object'||Array.isArray(data.files)||!Object.keys(data.files).length){t('Invalid backup configuration',true);return;}
                var recs=data.recipes===undefined?[]:data.recipes;if(!Array.isArray(recs)||!recs.every(r=>r&&validateSteps(r.mashSteps||[],r.boilSteps||[])&&validBrewSettings(r.brewSettings||{}))){t('Invalid backup recipes',true);return;}
                showConfirm('Restore this backup? Matching settings and recipe IDs will be replaced, then the device will reboot.',function(yes){if(!yes||bulkBusy)return;bulkBusy=true;(async function(){try{
                    var boot=S.boot||AUTH.boot,total=1+recs.length;showProg('Restoring backup...',0,total,'configuration');await sleep(300);
                    var cr=await apiP('/rest/restorebackup','POST',{files:data.files});if(!cr.ok)throw new Error('Configuration restore failed');
                    for(var i=0;i<recs.length;i++){await sleep(500);showProg('Restoring recipes...',i+1,total,recs[i].name||'Recipe');var rr=await apiP('/rest/saveRecipe','POST',recs[i]);if(!rr.ok)throw new Error('Restore incomplete: failed recipe '+(recs[i].name||recs[i].id));}
                    showProg('Restoring backup...',total,total,'done');progDone();progNote('Waiting for reboot...');await sleep(1000);
                    var restarX␀␀␀W␀␀␀t=await apiP('/rest/restart','POST',null);if(!restart.ok)throw new Error('Restore completed, but reboot request failed');await waitForReboot(boot);location.reload();
                }catch(err){hideLoad();t(err.message,true);}finally{bulkBusy=false;}})();});
            };reader.readAsText(file);
        }
        var pendingImports=[];
        function handleImportOpen(){if(bulkBusy)return;var inp=document.createElement('input');inp.type='file';inp.accept='.json,.xml';inp.multiple=true;inp.style.display='none';document.body.appendChild(inp);inp.oncancel=()=>inp.remove();inp.onchange=async function(e){if(bulkBusy){inp.remove();return;}bulkBusy=true;pendingImports=[];try{for(var file of Array.from(e.target.files)){var content=await new Promise((resolve,reject)=>{var reader=new FileReader();reader.onload=ev=>resolve(ev.target.result);reader.onerror=()=>reject(new Error('Could not read '+file.name));reader.readAsText(file);});if(file.name.split('.').pop().toLowerCase()==='xml')parseXmlToImports(content);else parseJsonToImports(content);}showImportPreview();}catch(err){pendingImports=[];t(err.message,true);}finally{bulkBusy=false;inp.remove();}};inp.click();}
        function getXmlText(p,tag){var c=p.childNodes;for(var i=0;i<c.length;i++){if(c[i].nodeName===tag)return c[i].textContent||'';}return'';}
        function enqueueRecipe(data){
            if(!data||typeof data!=='object'||!(Array.isArray(data.mashSteps)||Array.isArray(data.boilSteps))){t('Unknown recipe format',true);return false;}
            var recipe={name:data.name||'Imported Recipe',mashSteps:data.mashSteps||[],boilSteps:data.boilSteps||[],brewSettings:data.brewSettings||{}};
            if(typeof recipe.name!=='string'||!validateSteps(recipe.mashSteps,recipe.boilSteps)||!validBrewSettings(recipe.brewSettings))return false;
            pendingImports.push(recipe);return true;
        }
        function validBrewSettings(settings){if(!settings||typeof settings!=='object'||Array.isArray(settings))return false;for(var k of Object.keys(CFG_LIMITS)){if(settings[k]===undefined)continue;var v=settings[k],lim=CFG_LIMITS[k];if(!Number.isFinite(v)||v<lim[0]||v>lim[1]||(lim[2]&&!Number.isInteger(v))){t('Invalid imported setting: '+k,true);return false;}}return true;}
        function parseXmlToImports(content){
            var xml=new DOMParser().parseFromString(content,'text/xml');if(xml.getElementsByTagName('parsererror').length){t('Invalid XML',true);return;}
            for(var rec of Array.from(xml.getElementsByTagName('RECIPE'))){var mashSteps=Array.from(rec.getElementsByTagName('MASH_STEP')).map((s,i)=>({n:getXmlText(s,'NAME')||'Step '+(i+1),t:Number(getXmlText(s,'STEP_TEMP')||65),tm:Number(getXmlText(s,'STEP_TIME')||60),r:true,ho:true,fp:false,sl:false}));
                var boilSteps=Array.from(rec.getElementsByTagName('HOP')).filter(h=>['boil','first wort'].includes(getXmlText(h,'USE').toLowerCase())).map(h=>({n:getXmlText(h,'NAME')||'Hops',tm:Number(getXmlText(h,'TIME')||60),a:Math.round(Number(getXmlText(h,'AMOUNT')||0)*1000),md:0,tp:0}));
                var settings={btemp:Number(getXmlText(rec,'BOIL_TEMP')||92)},bt=getXmlText(rec,'BOIL_TIME');if(bt)settings.bt=Number(bt);enqueueRecipe({name:getXmlText(rec,'NAME')||'Imported Recipe',mashSteps:mashSteps,boilSteps:boilSteps,brewSettings:settings});
            }
        }
        function parseJsonToImports(content){try{
            var data=JSON.parse(content);if(!data||typeof data!=='object')throw new Error('Expected a recipe object');
            if(data.files){if(data.recipes!==undefined&&!Array.isArray(data.recipes))throw new Error('Invalid backup recipe list');(data.recipes||[]).forEach(enqueueRecipe);t('Only recipes are selected here. Use Setup > Backup > Import to restore settings.');}
            else if(Array.isArray(data.mashSteps)||Array.isArray(data.boilSteps)){enqueueRecipe(data);}
            else if(data.mashProfile||data.mash||Array.isArray(data.hops)){
                var steps=(data.mashProfile&&data.mashProfile.steps)||(data.mash&&data.mash.steps)||[],hops=data.hops||[];if(!AY␀␀␀rray.isArray(steps)||!Array.isArray(hops))throw new Error('Invalid external steps');
                var mash=steps.map((s,i)=>({n:s.name||s.stepName||'Step '+(i+1),t:s.stepTemp??s.temperature??65,tm:s.stepTime??s.time??60,r:true,ho:true,fp:false,sl:false}));
                var boil=hops.filter(h=>['boil','first wort'].includes((h.use||'').toLowerCase())).map(h=>({n:h.name||'Hops',tm:h.time??60,a:h.amount??0,md:0,tp:0}));
                var settings={};if(data.boilTime!==undefined)settings.bt=data.boilTime;if(data.boilTemp!==undefined)settings.btemp=data.boilTemp;
                enqueueRecipe({name:data.name||'Imported Recipe',mashSteps:mash,boilSteps:boil,brewSettings:settings});
            }else t('Unknown recipe format',true);
        }catch(err){t('Invalid JSON recipe: '+err.message,true);}}
        function showImportPreview(){if(pendingImports.length===0){t("No recipes found",true);return;}var el=document.getElementById('import-preview-list');var h='';for(var i=0;i<pendingImports.length;i++){var r=pendingImports[i];var info=r.mashSteps.length+' mash, '+r.boilSteps.length+' boil';h+='<div style="margin-bottom:6px;padding:8px;background:var(--bg-main);border-radius:8px;border:1px solid var(--border)"><input type="text" id="imp-name-'+i+'" value="'+esc(r.name).replace(/"/g,'&quot;')+'" style="width:100%;margin-bottom:2px;font-weight:700"><span style="font-size:10px;color:var(--text-dim)">'+info+'</span></div>';}el.innerHTML=h;document.getElementById('import-preview-modal').style.display='flex';}
        function confirmImport(){if(bulkBusy||!pendingImports.length)return;for(var i=0;i<pendingImports.length;i++){var el=document.getElementById('imp-name-'+i);if(el)pendingImports[i].name=el.value.trim();if(!pendingImports[i].name){t('Recipe name is required',true);return;}}document.getElementById('import-preview-modal').style.display='none';var items=pendingImports.slice();pendingImports=[];bulkBusy=true;return (async function(){var imp=0,total=items.length;try{showProg('Importing...',0,total,'recipes');for(var i=0;i<total;i++){var r=items[i];showProg('Importing...',i,total,r.name);var rr=await apiP('/rest/saveRecipe','POST',r);if(!rr.ok)throw new Error('Import incomplete: '+imp+'/'+total+' saved; failed '+r.name);imp++;await sleep(500);}showProg('Importing...',total,total,'done');progDone();await sleep(500);t('Imported '+imp+' recipe(s)');loadRecipes();}catch(err){t(err.message,true);}finally{hideLoad();bulkBusy=false;}})();}
        function cancelImport(){document.getElementById('import-preview-modal').style.display='none';pendingImports=[];}
        function initAccessibility(){
            document.querySelectorAll('.form-group').forEach(group=>{var label=group.querySelector('label'),field=group.querySelector('input[id],select[id],textarea[id]');if(label&&field&&!label.querySelector('input'))label.htmlFor=field.id;});
            ['api-enabled','api-token','man-target-input','boil-pwm-input','at-target','recipe-search','restore-file','ota-file'].forEach(id=>{var e=document.getElementById(id);if(e)e.setAttribute('aria-label',({'api-enabled':'Enable login','api-token':'Login password','man-target-input':'Target temperature','boil-pwm-input':'Power percent','at-target':'Auto Tune target temperature','recipe-search':'Search recipes','restore-file':'Backup file','ota-file':'OTA image'})[id]);});
            document.getElementById('toast').setAttribute('role','status');document.getElementById('toast').setAttribute('aria-live','polite');
            var bar=document.querySelector('.status-bar');bar.tabIndex=0;bar.setAttribute('role','button');bar.setAttribute('aria-label','Toggle navigation');bar.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleSidebar();}});
            var modals=Array.from(document.querySelectorAll('[id$="-modal"],#weakwifi-banner')),top=null;
            function focusable(m){return Array.from(m.querySelectorAll('button,input,select,textarea,a[href],[tabindex="0"]')).filter(e=>!e.disabled&&e.getClientRects().length);}
            function update(){var viZ␀␀␀Y␀␀␀W␀␀␀sible=modals.filter(m=>m.style.display==='flex').sort((a,b)=>Number(getComputedStyle(a).zIndex)-Number(getComputedStyle(b).zIndex)),next=visible[visible.length-1]||null;
                modals.forEach(m=>{if(m.style.display==='flex'&&!m._wasOpen){m._returnFocus=document.activeElement;m._wasOpen=true;}else if(m.style.display!=='flex')m._wasOpen=false;});
                var previous=top;top=next;document.querySelector('.main').inert=!!top;sidebar.inert=!!top;
                if(previous!==top){if(top){var fields=focusable(top);(fields[0]||top).focus();}else if(previous&&previous._returnFocus&&previous._returnFocus.isConnected)previous._returnFocus.focus();}
            }
            modals.forEach(m=>{m.setAttribute('role','dialog');m.setAttribute('aria-modal','true');m.setAttribute('aria-label',m.id.replace(/-/g,' '));m.tabIndex=-1;new MutationObserver(update).observe(m,{attributes:true,attributeFilter:['style']});});
            var cancel={'confirm-modal':()=>confirmAction(false),'input-modal':()=>inputAction(false),'login-modal':loginIgnore,'man-target-modal':manTargetCancel,'boil-pwm-modal':boilPwmCancel,'wifi-scan-modal':closeScanModal,'import-preview-modal':cancelImport,'ota-confirm-modal':closeOtaConfirm,'autotune-modal':closeAutoTune};
            document.addEventListener('keydown',function(e){if(!top)return;if(e.key==='Escape'&&cancel[top.id]){e.preventDefault();cancel[top.id]();return;}if(e.key!=='Tab')return;var fields=focusable(top),index=fields.indexOf(document.activeElement);if(!fields.length){e.preventDefault();top.focus();}else if(e.shiftKey&&index<=0){e.preventDefault();fields[fields.length-1].focus();}else if(!e.shiftKey&&(index<0||index===fields.length-1)){e.preventDefault();fields[0].focus();}});update();
        }
        initAccessibility();
        renderGauge("g-main","MAIN TEMP",null,null,"#ff9800");
        renderGauge("g-sparge","SPARGE TEMP",null,null,"#2196f3");
        renderGauge("g-boil","BOIL TEMP",null,null,"#f44336");
        renderGauge("g-pwm","PWM",null,null,"#707eae",100,"#707eae");
        setInterval(updateWiFi,15000);updateWiFi();
        poll();
        document.addEventListener('keydown',function(e){if(e.key!=='ArrowUp'&&e.key!=='ArrowDown')return;var d=e.key==='ArrowUp'?-1:1;var mt=document.getElementById('rtab-mash');if(mt&&!mt.classList.contains('hidden')&&mashMove>=0){e.preventDefault();moveMash(mashMove,d);return;}var bt=document.getElementById('rtab-boil');if(bt&&!bt.classList.contains('hidden')&&boilMove>=0){e.preventDefault();moveBoil(boilMove,d);return;}});
        initAuth();
        var holdT=null,holdFired=false,holdTgt=null,holdX=0,holdY=0;
        function cancelPumpHold(){if(holdT)clearTimeout(holdT);holdT=null;holdTgt=null;holdFired=false;}
        document.addEventListener('pointerdown',function(e){cancelPumpHold();if(e.button!==0)return;var pu=e.target.closest('.pmpbtn');if(pu&&!pu.disabled){holdTgt=e.pointerId;holdX=e.clientX;holdY=e.clientY;holdT=setTimeout(function(){holdFired=true;cmdPrime();},2000);}});
        document.addEventListener('pointermove',function(e){if(e.pointerId===holdTgt&&Math.hypot(e.clientX-holdX,e.clientY-holdY)>12)cancelPumpHold();});
        document.addEventListener('pointerup',function(e){if(e.pointerId===holdTgt&&!holdFired&&e.target.closest('.pmpbtn'))cmdPump();cancelPumpHold();});
        document.addEventListener('pointercancel',cancelPumpHold);window.addEventListener('blur',cancelPumpHold);
        document.addEventListener('click',function(e){if(e.detail===0&&e.target.closest('.pmpbtn'))cmdPump();});
        var swX=0,swY=0,swOn=false;
        document.addEventListener('touchstart',function(e){if(e.touches.length!==1){swOn=false;return;}var t=e.target;if(swModalOpen()||(t.closest&&t.closest('input,select,textarea,button,a,.sidebar,.config-tabs,#g-pwm'))){swOn=false;return;}swX=e.touches[0].clientX;swY=e.touches[0].clientY;swOn=true;},{passive:true});
        document.addEventListener('touchend',function(e){if(!swOn)return;swOn=false;var t=e.changedTouches[0];var dx=t.clientX-swX,dy=t.clientY-swY;if(Math.[␀␀␀abs(dx)>60&&Math.abs(dx)>Math.abs(dy)*1.5){swNav(dx<0?1:-1);}},{passive:true});
        (function(){var gp=document.getElementById('g-pwm');if(!gp)return;function gpEp(){if(S&&S.brew){if(S.step===2&&S.phase!==6)return '/rest/boilpower';if(S.phase===8)return '/rest/manualpower';}return null;}function pctFrom(e){var sv=gp.querySelector('svg')||gp;var r=sv.getBoundingClientRect();var dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2);var a=(Math.atan2(dx,-dy)*180/Math.PI+495)%360;if(a>270)return a<315?100:0;return Math.round(a/2.7);}var gpDown=null;gp.addEventListener('pointerdown',function(){gpDown=gpEp();});gp.addEventListener('pointerup',function(e){if(gpDown){openBoilPwm(pctFrom(e),gpDown);}gpDown=null;});}());
        document.addEventListener('touchstart',function fs(){var d=document.documentElement;if(d.requestFullscreen)d.requestFullscreen().catch(function(){});else if(d.webkitRequestFullscreen)d.webkitRequestFullscreen();document.removeEventListener('touchstart',fs);},{once:true});
        setTimeout(function(){window.scrollTo(0,1);},100);
        var wakeLock=null;function reqWake(){if(navigator.wakeLock){navigator.wakeLock.request('screen').then(function(wl){wakeLock=wl;}).catch(function(){});}}document.addEventListener('visibilitychange',function(){if(document.visibilityState==='visible')reqWake();});        reqWake();
        initPwmHold();
        (function(){var cv=document.getElementById('matrix-canvas');if(!cv)return;var ctx=cv.getContext('2d');var running=false,raf=null,cols=[],drops=[],last=0;var GLYPHS='ã‚¢ã‚¡ã‚«ã‚µã‚¿ãƒŠãƒãƒžãƒ¤ãƒ£ãƒ©ãƒ¯ã‚¬ã‚¶ãƒ€ãƒãƒ‘0123456789ABCDEF';var CW=14,CH=18;function size(){cv.width=window.innerWidth;cv.height=window.innerHeight;}window.addEventListener('resize',size);size();function tick(ts){if(!running)return;raf=requestAnimationFrame(tick);if(ts-last<50)return;last=ts;ctx.fillStyle='rgba(0,0,0,0.06)';ctx.fillRect(0,0,cv.width,cv.height);ctx.font=CH+'px monospace';for(var i=0;i<drops.length;i++){var ch=GLYPHS[Math.floor(Math.random()*GLYPHS.length)];var x=i*CW,y=drops[i]*CH;var head=Math.random()>0.975;ctx.fillStyle=head?'#eaffea':'#00ff41';ctx.shadowColor='#00ff41';ctx.shadowBlur=head?10:5;ctx.fillText(ch,x,y);ctx.shadowBlur=0;if(y>cv.height&&Math.random()>0.975)drops[i]=Math.floor(Math.random()*-20);drops[i]++;}}function start(){if(running)return;running=true;size();var n=Math.ceil(cv.width/CW);cols=n;drops=[];for(var i=0;i<n;i++)drops[i]=Math.floor(Math.random()*-40);ctx.fillStyle='rgba(0,0,0,0.85)';ctx.fillRect(0,0,cv.width,cv.height);last=0;raf=requestAnimationFrame(tick);}function stop(){running=false;if(raf)cancelAnimationFrame(raf);raf=null;ctx.clearRect(0,0,cv.width,cv.height);cv.classList.remove('on');}var panel=document.getElementById('timer-panel');if(!panel)return;var holdT=null,holdFired=false,clicks=0,clickT=null;function cancelHold(){if(holdT){clearTimeout(holdT);holdT=null;}}panel.addEventListener('pointerdown',function(){holdFired=false;cancelHold();holdT=setTimeout(function(){holdFired=true;cv.classList.add('on');start();},3000);});panel.addEventListener('pointerup',function(){cancelHold();if(holdFired)holdFired=false;});panel.addEventListener('pointerleave',function(){cancelHold();});document.addEventListener('dblclick',function(){if(running){stop();clicks=0;}});})();
    </script>
</body>
