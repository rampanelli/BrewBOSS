        function fmtTs(s){if(s<0)s=0;var h=Math.floor(s/3600),m=Math.floor((s%3600)/60),se=s%60;var a=function(v){return(v<10?"0":"")+v;};return'<span class=n>'+a(h)+'</span><span class=c>:</span><span class=n>'+a(m)+'</span><span class=c>:</span><span class=n>'+a(se)+'</span>';}
        function renderEvents(ev){
            var h='',n=ev.length;if(!n){document.getElementById('evt').innerHTML='<div><span class=ems>No steps recorded yet.</span></div>';return;}var baseTs=ev[0].ts,prevNtp=0;
            for(var i=0;i<n;i++){var e=ev[i],name=e.type||'',msg=e.msg||'',dur='';if(e.ntp&&prevNtp)dur=brewHms(Math.max(0,e.ntp-prevNtp));else if(e.ntp)dur='00:00:00';if(e.ntp)prevNtp=e.ntp;
                var cls='',label=name;if(name==='COMPLETE'){cls='done';label='DONE';msg='<span class=blink style=color:var(--text-main)>Thank you for using BrewBOSS</span>';}
                else if(name==='MASH_DONE'){cls='done';label='DONE';}else if(name==='MASH_STEP'){cls='mash';label='MASH';}else ifI␀␀␀(name==='MASH_TARGET'){cls='done';label='TARGET';}
                else if(name==='BOIL_STEP'||name==='BOIL_START'){cls='boil';label='BOIL';}else if(name==='HOP_ADD'){cls='add'+(/\d+g/.test(msg)?' w':'');label='ADD';}
                else if(name==='POSBOIL_START'){cls='boil';label='PBOIL';}else if(name==='POSBOIL_ADD'){cls='add'+(/\d+g/.test(msg)?' w':'');label='PBOIL';}else if(name==='POSBOIL_REM'){cls='boil';label='REMOVE';}
                else if(name==='COOLING'){cls='done';label='COOL';}else if(name==='MANUAL'){cls='mash';label='MANUAL';}else if(name==='MTARGET'){cls='done';label='TARGET';}
                else if(name==='HEAP_CRIT'){label='CRIT';}else if(name==='HEAP_WARN'){label='WARN';}
                if(name!=='COMPLETE'){if(name==='MASH_DONE'){var mt=msg.match(/Done:(.+)/),sk=msg.match(/Skip:(.+)/);if(mt)msg=mt[1]+' DONE';else if(msg==='Mash->Boil')msg='Mash DONE > Boil PHASE';else if(sk)msg=sk[1]+' SKIPPED';}if(name==='PAUSE')msg='Brew PAUSED';if(msg.indexOf('M:')===0)msg=msg.substring(2);msg=esc(msg);}
                var elapsed=Math.max(0,e.ts-baseTs),col1=e.ntp?dur:brewHms(elapsed),fl=e.fl||'',clk=e.ntp?new Date(e.ntp*1000).toISOString().substr(11,8):'',lc=clk?'<span class=eclk>'+clk+'</span>':'<span class=ets>'+fmtTs(elapsed)+'</span>';
                h+='<div><span class=eidx>'+col1+'</span><span class="ety '+cls+'">'+esc(label)+'</span><span class=ems>'+msg+'</span>'+(fl?'<span class=efl>'+esc(fl)+'</span>':'')+lc+'</div>';
            }var el=document.getElementById('evt');el.innerHTML=h;el.scrollTop=el.scrollHeight;
        }
