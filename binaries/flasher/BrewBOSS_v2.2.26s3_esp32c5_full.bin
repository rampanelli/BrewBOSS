        var _atRetries=0,atMonitoring=false;
        function openAutoTune(){if(S.brew||S.delay){t('Stop brew or countdown first',true);return;}api('/rest/autotune/status','GET',null,function(j,ok){if(!ok||!j){t('Tuning status unavailable',true);return;}document.getElementById('at-target').value=displayTemp(Math.min(90,Number.isFinite(S.mainT)&&S.mainT>-900?S.mainT+10:60));document.getElementById('at-result').style.display='none';document.getElementById('at-btn-apply').style.display='none';document.getElementById('at-btn-start').style.display=j.state===1?'none':'block';document.getElementById('at-btn-cancel').textContent=j.state===1?'Stop':'Cancel';document.getElementById('at-status').textContent='Target (Â°'+unit+'), maximum '+displayTemp(90)+'Â°'+unit;document.getElementById('autotune-modal').style.display='flex';atMonitoring=true;_atRetries=0;if(j.state!==0)pollAutoTune();});}
        function startAutoTune(){var target=readNumber('at-target',0,90,false,unit);if(target===null)return;var btn=document.getElementById('at-btn-start');btn.disabled=true;api('/rest/autotune/start?target='+target,'POST',null,function(j,ok){btn.disabled=false;if(!ok){t((j&&j.error)||'Start failed',true);return;}document.getElementById('at-target').value=displayTemp(j.target);btn.style.display='none';document.getElementById('at-btn-cancel').textContent='Stop';atMonitoring=true;_atRetries=0;pollAutoTune();});}
        function pollAutoTune(){if(atTimer)clearTimeout(atTimer);atTimer=null;if(!atMonitoring)return;api('/rest/autotune/status','GET',null,function(j,ok){if(!atMonitoring)return;if(!ok||!j){document.getElementById('at-progress').textContent='Status unavailaU␀␀␀ble; tuning may still be running.';if(++_atRetries<5)atTimer=setTimeout(pollAutoTune,2000);else{atMonitoring=false;document.getElementById('at-status').textContent='Reopen Auto Tune to resume monitoring.';}return;}_atRetries=0;var st=j.state;if(st===1){document.getElementById('at-progress').textContent='Cycle: '+j.cycle+'/'+j.total+' | Output: '+j.output+'% | '+j.msg;atTimer=setTimeout(pollAutoTune,2000);return;}atMonitoring=false;document.getElementById('at-btn-cancel').textContent='Close';document.getElementById('at-progress').textContent=st===3?'FAILED: '+j.msg:st===2?'Tuning complete':'Tuning cancelled';if(st===2){document.getElementById('at-result').style.display='block';document.getElementById('at-result').textContent='Gains: kP='+j.kp+' kI='+j.ki+' kD='+j.kd;document.getElementById('at-btn-apply').style.display='block';}});}
        function cancelAutoTune(){if(document.getElementById('at-btn-cancel').textContent==='Stop'){api('/rest/autotune/cancel','POST',null,function(j,ok){if(ok)closeAutoTune();});}else closeAutoTune();}
