        function recipePagerMarkup(pages,cur){if(pages<=1)return "";var mk=function(label,p,extra,dis){return '<button class="tab-btn rp-btn'+(extra?" "+extra:"")+'"'+(dis?" disabled":"")+' onclick="gotoRecipePage('+p+')">'+label+"</button>";};var w0=Math.max(0,Math.min(cur-2,pages-5)),w1=Math.min(pages-1,w0+4);w0=Math.max(0,w1-4);var h='<span class="rp-info">Page '+(cur+1)+' of '+pages+'</span><div class="rp-nav">';h+=mk('Â«',0,'rp-ff',cur<=0);h+=mk('â€¹',cur-1,'rp-prev',cur<=0);if(w0>0)h+='<span class="rp-ell">â€¦</span>';for(var i=w0;i<=w1;i++)h+=mk(String(i+1),i,i===cur?'rp-cur':'',false);if(w1<pages-1)h+='<span class="rp-ell">â€¦</span>';h+=mk('â€º',cur+1,'rp-next',cur>=pages-1);h+=mk('Â»',pages-1,'rp-last',cur>=pages-1);h+='</div>';return h;}
        function loadRecipes(){api("/rest/listRecipes","GET",null,(j)=>{if(!j||!j.recipes)return;var recipes=j.recipes;var s=recipeSearch.toLowerCase();if(s)recipes=recipes.filter(r=>(r.name||"").toLowerCase().indexOf(s)>=0);recipes.sort(function(a,b){if(recipeSort==="name")return(a.name||"").localeCompare(b.name||"");if(recipeSort==="name-desc")return(b.name||"").localeCompare(a.name||"");if(recipeSort==="oldest")return(a.id||0)-(b.id||0);return(b.id||0)-(a.id||0);});var total=recipes.length;var pages=Math.max(1,Math.ceil(total/RECIPE_PAGE_SIZE));if(recipePage>=pages)recipePage=pages-1;if(recipePage<0)recipePage=0;var start=recipePage*RECIPE_PAGE_SIZE;var pageItems=recipes.slice(start,start+RECIPE_PAGE_SIZE);let h="";pageItems.forEach(r=>{var rIsActive=(loadedRecipeId&&r.id===loadedRecipeId)||(editingRecipeId&&r.id===editingRecipeId);h+=`<div class="list-item${rIsActive?' rec-active':''}" style="flex-direction:column;align-items:stretch"><b style="font-size:14px;margin-bottom:6px">${esc(r.name||'Recipe #'+r.id)}</b><div class="list-btns">`+`<button class="btn-pump" onclick="handleActivate(${r.id})">LOAD</button>`+`<button class="btn-secondary" onclick="handleEdit(${r.id})">EDIT</button>`+`<button class="btn-secondary" onclick="handleRename(${r.id})">REN</button>`+`<button class="btn-secondary" onclick="handleSaveConfig(${r.id})">CFG</button>`+`<button class="btn-secondary" onclick="handleDuplicate(${r.id})">COPY</button>`+`<button class="btn-secondary" onclick="handleExport(${r.id})">EXP</button>`+`<button class="btn-stop" onclick="handleDelete(${r.id})">DEL</button>`+`</div></div>`;});document.getElementById("recipe-list").innerHTML=h||"No recipes";var cntEl=document.getElementById("recipe-count");if(cntEl){if(total>0){var from=start+1,to=start+pageItems.length;cntEl.textContent=from+"-"+to+" of "+total;}else{cntEl.textContent="0 of 0";}}var pgEl=document.getElementById("recipe-pager");if(pgEl)pgEl.innerHTML=recipePagerMarkup(pages,recipePage);updateSortButtons();});}
        function cycleSort(){var modes=["name","name-desc","newest","oldest"];var i=modes.indexOf(recipeSort);recipeP␀␀␀O␀␀␀Sort=modes[(i+1)%modes.length];recipePage=0;loadRecipes();}
        function compactRecipeCards(){
            var list=document.getElementById('recipe-list');if(!list.offsetWidth)return;
            list.querySelectorAll('.list-item').forEach(item=>{
                ['padding-top','padding-bottom','margin-bottom'].forEach(p=>item.style.removeProperty(p));
                var buttons=Array.from(item.querySelectorAll('.list-btns button'));
                buttons.forEach(b=>['height','min-height','padding-top','padding-bottom'].forEach(p=>b.style.removeProperty(p)));
                var height=item.getBoundingClientRect().height,style=getComputedStyle(item),padding=parseFloat(style.paddingTop),gap=parseFloat(style.marginBottom);
                var heights=buttons.map(b=>b.getBoundingClientRect().height);
                buttons.forEach((b,i)=>{b.style.height=(heights[i]*0.72)+'px';b.style.minHeight='0';b.style.paddingTop=b.style.paddingBottom='0';});
                // Account for wrapped button rows while keeping the whole card at 80% of its original height.
                var compactPadding=Math.max(0,padding+(height*0.8-item.getBoundingClientRect().height)/2);
                item.style.paddingTop=item.style.paddingBottom=compactPadding+'px';
                item.style.marginBottom=(gap*0.5)+'px';
            });
        }
