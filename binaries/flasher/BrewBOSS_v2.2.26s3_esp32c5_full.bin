        function fitGaugeText(id){
            const el=document.getElementById(id),svg=el.querySelector('.gauge-svg').getBoundingF␀␀␀E␀␀␀C␀␀␀?␀␀␀ClientRect();
            if(!svg.width)return;
            const panel=el.parentElement.getBoundingClientRect(),box=el.getBoundingClientRect();
            const gaugeTop=svg.top+svg.height*0.0688; // Y=10 minus half the stroke (3.12).
            el.querySelector('.gauge-label').style.top=((panel.top+gaugeTop)/2-box.top)+'px';
            // Bottom of the 270-degree arc: endpoint Y (78.2843) plus half its stroke (3.12).
            const gaugeBottom=svg.top+svg.height*0.814043;
            el.querySelector('.gauge-target').style.top=((gaugeBottom+panel.bottom)/2-box.top)+'px';
            const content=el.querySelector('.gauge-content');
            const parts=[content.querySelector('.gauge-val'),content.querySelector('.gauge-unit')];
            const sizes=parts.map(e=>parseFloat(getComputedStyle(e).fontSize));
            const cx=svg.left+svg.width/2,cy=svg.top+svg.height/2,radius=svg.width*0.355;
            const range=document.createRange();
            function fits(){
                const walker=document.createTreeWalker(content,NodeFilter.SHOW_TEXT);
                let node;
                while(node=walker.nextNode()){
                    if(!node.textContent.trim())continue;
                    range.selectNodeContents(node);
                    for(const rect of range.getClientRects()){
                        for(const x of [rect.left,rect.right])for(const y of [rect.top,rect.bottom]){
                            if(Math.hypot(x-cx,y-cy)>radius)return false;
                        }
                    }
                }
                return true;
            }
            function trySize(factor){parts.forEach((e,i)=>e.style.fontSize=(sizes[i]*factor)+'px');return fits();}
            for(var factor=1.08;factor>=0.6;factor-=0.04){if(trySize(factor))break;}
        }
