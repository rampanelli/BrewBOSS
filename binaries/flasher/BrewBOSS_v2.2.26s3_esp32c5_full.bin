        function rssiColor(r){return r>-68?'#05cd99':(r>-80?'#ff9800':'#f44336');}
        function savedTag(ss){return savedNetMap.hasOwnProperty(ss)?' <span title="Previously connected" style="color:#0E9E67">&#10003;</span>':'';}
        function renderScanList(){var h='';for(var i=0;i<scanResults.length;i++){var n=scanResults[i];h+='<div style="padding:8px;margin-bottomR␀␀␀Q␀␀␀O␀␀␀:4px;background:var(--bg-main);border-radius:8px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;border:1px solid var(--border)" onclick="selNet('+i+')"><span style="font-weight:700;font-size:13px">'+esc(n.ssid)+savedTag(n.ssid)+'</span><span style="color:'+rssiColor(n.rssi)+';font-size:11px">'+n.rssi+'dBm</span></div>';}if(!h)h='<p style="text-align:center;color:var(--text-dim)">No networks found</p>';document.getElementById('wifi-scan-list').innerHTML=h;}
        // C5: seleciona rede e mostra senha salva editavel + CONNECT/DELETE.
        function selNet(i){
            if(!scanC5){selectNetwork(i);return;}
            if(i<0||i>=scanResults.length)return;scanSel=i;var n=scanResults[i];var sv=savedNetMap.hasOwnProperty(n.ssid)?savedNetMap[n.ssid]:'';
            var h='<div style="padding:8px;background:var(--bg-main);border-radius:8px;border:1px solid var(--border)">';
            h+='<div style="font-weight:700;font-size:13px;margin-bottom:4px">'+esc(n.ssid)+' <span style="color:'+rssiColor(n.rssi)+';font-size:11px">'+n.rssi+'dBm</span></div>';
            h+='<div class="form-group" style="margin:0"><label for="wifi-net-pass">Password</label><input type="password" id="wifi-net-pass" style="width:100%"></div>';
            h+='<div style="display:flex;gap:6px;margin-top:8px"><button class="btn-success" style="flex:1" onclick="connectNet()">CONNECT</button>';
            if(savedNetMap.hasOwnProperty(n.ssid))h+='<button class="btn-stop" style="flex:none;width:auto;padding:8px 12px" onclick="delNet()">DELETE</button>';
            h+='</div></div>';
            document.getElementById('wifi-scan-list').innerHTML=h;
