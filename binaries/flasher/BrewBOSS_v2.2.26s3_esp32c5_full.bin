        var _otaSubmitting=false,_otaSelection=null,_otaPending=null;
        function otaDetectType(h,size){
            if(h.length<32)return '';
            var v=new DataView(h.buffer,h.byteOffset,h.byteLength);
            if(h[0]===0xE9&&h[1]>0&&h[1]<=16){
                // ESP8266 entry point, or ESP32-family application descriptor (not a bootloader).
                if((v.getUint32(4,true)>>>16)===0x4010||(h.length>=36&&v.getUint32(32,true)===0xABCD5432))return 'firmware';
            }
            // LittleFS v2 superblock generated by the supported targets; never infer FS from a missing E9.
            if(v.getUint32(4,false)===0xF00FFFF7&&String.fromCharCode(...h.slice(8,16))==='littlefs'&&v.getUint32(16,false)===0x2FE00010){
                var version=v.getUint32(20,true),blockSize=v.getUint32(24,true),blocks=v.getUint32(28,true);
                if((version>>>16)===2&&[4096,8192].includes(blockSize)&&blocks>=2&&blockSize*blocks===size)return 'filesystem';
            }
            return '';
        }
        function otaFileSelected(e){
            var f=e.target.files[0],btn=document.getElementById('ota-upload-btn'),info=document.getElementById('ota-image-type');_otaSelection=null;_otaPending=null;btn.style.display='none';info.textContent='';
            document.getElementById('ota-file-name').textContent=f?f.name:'No file selected';if(!f)return;
            if(!/\.bin$/i.test(f.name)||f.size<32||f.size>4*1024*1024){t('Select a valid .bin image (32 bytes to 4 MB)',true);return;}
            info.textContent='Detecting image...';
            var reader=new FileReader();reader.onload=function(ev){if(document.getElementById('ota-file').files[0]!==f)return;var type=otaDetectType(new Uint8Array(ev.target.result),f.size);if(!type){info.textContent='Unrecognized image';t('Select an application-only firmware or a LittleFS image',true);return;}_otaSelection={file:f,type:type};var fs=type==='filesystem';info.textContent=fs?'Detected: LittleFS (erases settings)':'Detected: Firmware (application only)';btn.textContent=fs?'Upload Filesystem':'Upload Firmware';btn.className=fs?'btn-stop':'btn-secondary';btn.style.display='block';};reader.onerror=function(){if(document.getElementById('ota-file').files[0]!==f)return;info.textContent='Image read failed';t('Failed to read image',true);};reader.readAsArrayBuffer(f.slice(0,64));
        }
        function confirmOTA(){
            if(_otaSubmitting||!_otaSelection)return;if(AUTH.token===null){t('Login before uploading',true);showLogin();return;}
            _otaPending={file:_otaSelection.file,isFS:_otaSelection.type==='filesystem'};if(_otaPending.isFS)document.getElementById('ota-confirm-modal').style.display='flex';else proceedOta(_otaPending.file,false);
        }
        function proceedOta(file,isFS){if(S.brew||S.delay){showConfirm('Stop the brew or countdown before uploading?',function(r){if(r)api('/rest/stopbrew','POST',null,function(j,ok){if(ok)startOTA(file,isFS);});});}else startOTA(file,isFS);}
        function doOtaConfirm(){document.getElementById('ota-confirm-modal').style.display='none';if(_otaPending)proceedOta(_otaPending.file,true);}
        function closeOtaConfirm(){document.getElementById('ota-confirm-modal').style.display='none';}
        var _confirmCb=null;
        function showConfirm(msg,cb){document.getElementById('confirm-msg').textContent=msg;document.getElementById('confirm-modal').style.display='flex';_confirmCb=cb;}
        function confirmAction(ok){document.getElementById('confirm-modal').style.display='none';var cb=_confirmCb;_confirmCb=null;if(cb)cb(ok);}
        var _inputCb=null;
        function showInput(msg,def,cb){document.getElementById('input-msg').textContent=msg;var i=document.getElementById('input-val');i.value=def||'';document.getElementById('input-modal').style.display='flex';_inputCb=cb;setTimeout(fT␀␀␀S␀␀␀unction(){i.focus();i.select();},80);}
