        function saveBoilStep(){
            var m=document.querySelector('input[name=bsmd]:checked'),md=m?Number(m.value):0,tp=md?readNumber('bs-tp',0,100,false,unit):0,time=md===2?0:readNumber('bs-tm',0,600,true),amount=md===2?0:readNumber('bs-a',0,65535,false);
