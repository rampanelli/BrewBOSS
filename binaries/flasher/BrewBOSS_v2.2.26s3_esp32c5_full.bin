            xhr.onload=function(){if(xhr.status===200){fileInput.value='';_otaSelection=null;btn.style.display='none';document.getElementById('ota-file-name').textContent='No file selected';document.getElementById('ota-image-type').textContent='';prMsg.textContent='Flash update accepted. Waiting for reboot...';waitForReboot(boot).then(()=>location.reload()).catch(e=>{prMsg.textContent=e.message;unlock();});}else{prMsg.textContent='Upload failed ('+xhr.status+'): '+xhr.responseText;unlock();if(xhr.status===401){AUTH.token=null;saveAuth();setReadOnly(true);showLogin();}}};
