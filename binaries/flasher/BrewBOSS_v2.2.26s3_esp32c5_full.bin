    <title>BrewBOSS</title>
    <style>
        :root {
            --bg-main: #eef1f8;
            --sidebar-bg: linear-gradient(180deg, rgba(99, 102, 241, 0.92) 0%, rgba(49, 46, 129, 0.94) 100%);
            --card-bg: rgba(255, 255, 255, 0.62);
            --text-main: #1e2a52;
            --text-dim: #5f6b86;
            --border: rgba(255, 255, 255, 0.55);
            --shadow: 0 1px 2px rgba(30, 41, 59, 0.04), 0 12px 32px -8px rgba(30, 41, 59, 0.10);
            --btn-pump: #2F80ED;
            --btn-prime: #8AB4F8;
            --btn-boil: #E5484D;
            --btn-start: #D97706;
            --btn-stop: #E5484D;
            --btn-pause: #D97706;
            --btn-skip: #64748B;
            --btn-success: #0E9E67;
            --btn-secondary: #64748B;
            /* chrome macOS: tons suaves, hairline, brilho discreto */
            --btn-line: rgba(30, 41, 59, 0.08);
            --btn-chip: rgba(100, 116, 139, 0.12);
            --btn-chip-line: rgba(100, 116, 139, 0.30);
            --btn-glow: 0 1px 2px rgba(30, 41, 59, 0.06), 0 8px 18px -12px rgba(30, 41, 59, 0.28);
            /* liquid glass */
            --glass-blur: 22px;
            --glass-tint: rgba(255, 255, 255, 0.55);
            --glass-edge: rgba(255, 255, 255, 0.65);
            --glass-hi: rgba(255, 255, 255, 0.85);
            --glass-shadow: 0 1px 1px rgba(255,255,255,0.5) inset, 0 1px 2px rgba(30,41,59,0.05), 0 16px 40px -12px rgba(30,41,59,0.18);
            --glass-radius: 22px;
        }
        [data-theme="dark"] {
            --bg-main: #0b1437;
            --card-bg: rgba(255, 255, 255, 0.07);
            --text-main: #ffffff;
            --text-dim: #a3aed0;
            --border: rgba(255, 255, 255, 0.12);
            --shadow: 0px 10px 30px rgba(0, 0, 0, 0.2);
            --sidebar-bg: linear-gradient(180deg, rgba(30, 27, 75, 0.92) 0%, rgba(10, 10, 30, 0.95) 100%);
            --glass-tint: rgba(255, 255, 255, 0.06);
            --glass-edge: rgba(255, 255, 255, 0.14);
            --glass-hi: rgba(255, 255, 255, 0.10);
            --glass-shadow: 0 1px 1px rgba(255,255,255,0.08) inset, 0 1px 2px rgba(0,0,0,0.3), 0 16px 40px -12px rgba(0,0,0,0.5);
        }
