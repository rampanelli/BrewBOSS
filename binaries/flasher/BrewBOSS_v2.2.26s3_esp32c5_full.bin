                if(AUTH.token!==null){var backup=await get('/rest/backupnow'),mash=await get('/rest/mash'),boil=await get('/rest/boil'),list=await get('/rest/listRecipes'),hit=list.recipes.find(r=>r.name===recipe),active=hit?await get('/rest/getRecipe?id='+hit.id):recipe?{name:recipe,mashSteps:mash.st||[],boilSteps:boil.st||[],brewSettings:cfg}:null;
                    lines.push('','# === SESSION BACKUP (JSON; current recipe only) ===','# Copy between BEGIN and END to a .json file.','# --- BEGIN BACKUP JSON ---',JSON.stringify({exportedAt:new Date().toISOString(),files:backup.files,recipes:active?[active]:[]},null,2),'# --- END BACKUP JSON ---');
                }else lines.push('# Session backup omitted: login is required.');
