        function startOTA(file,isFS){
            if(_otaSubmitting||AUTH.token===null)return;_otaSubmitting=true;var boot=S.boot||AUTH.boot,fileInput=document.getElementById('ota-file'),btn=document.getElementById('ota-upload-btn'),prFill=document.getElementById('ota-progress-fill'),prPct=document.getElementById('ota-progress-pct'),prMsg=document.getElementById('ota-progress-msg');btn.disabled=true;fileInput.disabled=true;
            document.getElementById('ota-progress-wrap').style.display='block';prFill.style.width='0%';prPct.textContent='0%';prMsg.textContent='Uploading '+(isFS?'filesystem':'firmware')+'...';
            function unlock(){_otaSubmitting=false;btn.disabled=false;fileInput.disabled=false;}
            var xhr=new XMLHttpRequest();xhr.open('POST',isFS?'/rest/otafs':'/rest/ota',true);xhr.timeout=120000;if(AUTH.token)xhr.setRequestHeader('X-Auth-Token',AUTH.token);
