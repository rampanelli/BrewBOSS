            var events=await get('/rest/events'),cfg=await get('/rest/config'),st=await get('/rest/status'),ev=events.events||[],recipe=S.recipeName||st.recipeName||'',lines=['# BrewBOSS brew export','# recipe,'+csvCell(recipe),'# exported,'+csvCell(new Date().toISOString()),'# version,'+csvCell(st.version||''),'','# === STEPS HISTORY ===','elapsed,ntp,type,message,flags'];
            var base=ev.length?ev[0].ts:0,prevNtp=0;ev.forEach(e=>{var elapsed=e.ntp?brewHms(prevNtp?e.ntp-prevNtp:0):brewHms(e.ts-base);if(e.ntp)prevNtp=e.ntp;lines.push([elapsed,e.ntp?new Date(e.ntp*1000).toISOString().substr(11,8):'',e.type||'',e.msg||'',e.fl||''].map(csvCell).join(','));});
